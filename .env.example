# ==============================================================================
# RAG System Environment Configuration Template (.env.example)
# 복사하여 .env 파일로 생성 후 사용하세요. (주의: .env는 절대 git에 커밋 금지)
# ==============================================================================

# [1] 애플리케이션 환경 (development | testing | production)
APP_ENV=development
APP_HOST=0.0.0.0
ADMIN_PORT=8501
USER_PORT=8502

# [2] 로컬 Ollama 모델 설정 (외부 유료/무료 API 키 불필요, 100% 로컬 무료 실행)
# 로컬 Ollama 서버 주소 (기본: http://localhost:11434, Docker 컨테이너 내에서는 http://host.docker.internal:11434)
OLLAMA_BASE_URL=http://localhost:11434

# 한국어 특화 최고 성능 오픈소스 LLM 모델
# 추천: exaone3.5 (LG AI연구원 한국어 최고 성능), qwen2.5:7b, llama3.1
OLLAMA_LLM_MODEL=exaone3.5

# 한국어 및 다국어 고성능 임베딩 모델
# 추천: bge-m3 (SOTA 한국어 문맥 임베딩), nomic-embed-text
OLLAMA_EMBED_MODEL=bge-m3

# [3] 벡터 데이터베이스 (ChromaDB) 영구 저장 경로
CHROMA_PERSIST_DIRECTORY=data/chroma_db
CHROMA_COLLECTION_NAME=rag_documents

# [4] 업로드 문서 저장 디렉토리
UPLOAD_DIRECTORY=data/uploads

# [5] 관리자(Admin) 보안 PIN 번호 (admin.py 접근 제어)
ADMIN_ACCESS_PIN=admin1234

# [6] 운영 환경(Production) 보안 관리 서비스 연동 옵션 (선택 사항)
# SECRETS_PROVIDER=aws_secrets_manager  # aws_secrets_manager | docker_secrets | vault
# AWS_REGION=ap-northeast-2
# AWS_SECRET_NAME=prod/rag_vibe/api_keys
