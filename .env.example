# ==============================================================================
# RAG System Environment Configuration Template (.env.example)
# 복사하여 .env 파일로 생성 후 실제 값을 입력하세요. (주의: .env는 절대 git에 커밋 금지)
# ==============================================================================

# [1] 애플리케이션 환경 (development | testing | production)
APP_ENV=development
APP_PORT=8501
APP_HOST=0.0.0.0

# [2] Google Gemini API 설정 (무료 티어 제공 / 한국어 최고 성능)
# https://aistudio.google.com/ 에서 무료 API 키 발급 가능
GEMINI_API_KEY=your_gemini_api_key_here

# [3] LLM 및 임베딩 모델 선택
# LLM: gemini-2.5-flash 또는 gemini-1.5-flash, gemini-3.8-flash
LLM_MODEL=gemini-2.5-flash
# 임베딩 모델: text-embedding-004 (768 차원, 한국어 고성능, 무료 티어)
EMBEDDING_MODEL=text-embedding-004

# [4] 벡터 데이터베이스 (ChromaDB) 설정
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=rag_documents

# [5] 업로드 파일 저장 디렉토리
UPLOAD_DIRECTORY=./data/uploads

# [6] 운영 환경(Production) 비밀 관리 서비스 연동 옵션 (선택 사항)
# USE_EXTERNAL_SECRETS=true
# SECRETS_PROVIDER=aws_secrets_manager  # aws_secrets_manager | docker_secrets | vault
# AWS_REGION=ap-northeast-2
# AWS_SECRET_NAME=prod/rag_vibe/api_keys
# DOCKER_SECRET_GEMINI_KEY_PATH=/run/secrets/gemini_api_key

# [7] HTTPS / SSL 설정 (운영 환경 권장)
# STREAMLIT_SERVER_ENABLE_CORS=false
# STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=true
# STREAMLIT_SERVER_SSL_CERT_FILE=/etc/ssl/certs/cert.pem
# STREAMLIT_SERVER_SSL_KEY_FILE=/etc/ssl/private/key.pem

# [8] Admin 보안 PIN / 비밀번호 (선택: Admin 탭 접근 제어)
ADMIN_ACCESS_PIN=admin1234
