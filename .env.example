# ==============================================================================
# Biosafety RAG Pipeline Environment Configuration (.env.example)
# 복사하여 .env 파일로 생성 후 사용하세요. (주의: .env는 절대 git에 커밋 금지)
# ==============================================================================

# [1] 애플리케이션 환경 (development | testing | production)
APP_ENV=development
APP_HOST=0.0.0.0
ADMIN_PORT=8501
USER_PORT=8502

# [2] LLM 제공자 설정 (gemini: 클라우드 API 무설치 초고속 | ollama: 로컬 하드웨어 실행)
LLM_PROVIDER=gemini

# [2-A] Google Gemini Cloud API 설정
# 발급: https://aistudio.google.com/app/apikey (무료 티어 제공)
# 중요: v1beta 지원 모델 사용 (gemini-2.5-flash 또는 gemini-2.0-flash 추천. 미설정 시 자동 선택)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# [2-B] 로컬 Ollama 모델 설정 (로컬 GPU/CPU 오프라인 실행 시)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=exaone3.5
OLLAMA_EMBED_MODEL=bge-m3

# [3] PDF 분류 및 OCR 임계값 설정
MIN_TEXT_CHARS_PER_PAGE=80
SCANNED_PAGE_RATIO=0.7
OCR_MIN_CONFIDENCE=55.0
OCR_LANGUAGE=kor+eng
OCR_DPI=300
PREFER_RAPIDOCR=true

# Windows Tesseract 실행 파일 수동 경로 (PATH 미등록 시 지정)
# 예: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# [4] 구조 보존형 청킹 설정
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MIN_CHUNK_SIZE=100

# [5] 벡터 데이터베이스 (ChromaDB) 영구 저장 경로
CHROMA_PERSIST_DIRECTORY=data/chroma_db
CHROMA_COLLECTION_NAME=rag_documents

# [6] 업로드 및 처리 디렉토리
UPLOAD_DIRECTORY=data/uploads

# [7] 관리자(Admin) 보안 PIN 번호
ADMIN_ACCESS_PIN=admin1234
